# CivicPulse Environment Configuration Template
# DO NOT commit real secrets or .env to version control

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000
IMAGE_TAG=latest

# Database (PostgreSQL 16)
POSTGRES_DB=civicpulse
POSTGRES_USER=civicpulse_user
POSTGRES_PASSWORD=civicpulse_secure_password_replace_in_prod
DATABASE_HOST=database
DATABASE_PORT=5432
DATABASE_URL=postgresql+asyncpg://civicpulse_user:civicpulse_secure_password_replace_in_prod@database:5432/civicpulse
# Synchronous DB URL for Alembic migrations & seed script
SYNC_DATABASE_URL=postgresql://civicpulse_user:civicpulse_secure_password_replace_in_prod@database:5432/civicpulse

# Cache & Distributed Rate Limiter (Redis 7)
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_PASSWORD=civicpulse_redis_secret_replace_in_prod
REDIS_URL=redis://:civicpulse_redis_secret_replace_in_prod@cache:6379/0

# Rate Limiting
RATE_LIMIT_PER_MINUTE=20

# AI Triage Layer Configuration
# Options: llm:groq | llm:gemini | llm:ollama | rules | simulated
TRIAGE_PROVIDER=simulated
TRIAGE_TIMEOUT_SECONDS=10
TRIAGE_CACHE_TTL_SECONDS=86400

# Hosted LLM API Credentials (Required if TRIAGE_PROVIDER is llm:groq or llm:gemini)
GROQ_API_KEY=gsk_placeholder_replace_with_real_key
GEMINI_API_KEY=placeholder_replace_with_real_gemini_key

# Local Ollama Configuration (Required if TRIAGE_PROVIDER is llm:ollama)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b

# Frontend
VITE_API_URL=/api
